{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./dist-services",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  },
  "include": [
    "services/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist-services",
    "**/*.test.ts"
  ]
}